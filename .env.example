# --- Profile: local (demo) or lz (Azure AI Landing Zone spoke) ---
APP_PROFILE=local

# --- Recommended for no-Docker /  (APP_PROFILE=local) ---
DATABASE_URL=sqlite+pysqlite:///./data/cmaa.db
STORAGE_DIR=./data/uploads
MOCK_LLM=true
RAG_ENABLED=true
LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
CONFIDENCE_REVIEW_THRESHOLD=0.7
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Review gate on assessments
ENFORCE_REVIEW=true

# MOCK_LLM=false plus Azure OpenAI enables LLM claim extraction plus prose.
# SKU selection stays catalog-based. Optional sizing explanation uses Azure OpenAI when configured.
SIZING_REGION=eastus
PRICING_CURRENCY=USD
AZURE_PRICING_LIVE=false
PRICING_TIMEOUT_SECONDS=3

# AI guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_ON_INJECTION=true
GUARDRAILS_BLOCK_ON_HARM=true
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_SEVERITY_THRESHOLD=2

# Optional Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cmaapassword

# --- Landing Zone spoke (APP_PROFILE=lz) — see docs/AI_LANDING_ZONE.md ---
# APP_PROFILE=lz
# USE_MANAGED_IDENTITY=true
# MOCK_LLM=false
# LOCAL_EMBEDDINGS=false
# DATABASE_URL=postgresql+psycopg://cmaaadmin:...@pg-host:5432/cmaa?sslmode=require
# AZURE_OPENAI_ENDPOINT=https://YOUR-AOAI.openai.azure.com/
# AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
# AZURE_SEARCH_INDEX=cmaa-chunks
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# API_AUTH_KEY=
# APIM_BASE_URL=https://your-apim.azure-api.net/cmaa

# --- Optional: Postgres locally ---
# DATABASE_URL=postgresql+psycopg://cmaa:cmaa@localhost:5432/cmaa

# --- Optional: Azure OpenAI + AI Search (local profile with keys) ---
USE_MANAGED_IDENTITY=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=cmaa-chunks
RAG_TOP_K=8
